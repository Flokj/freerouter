{
  "name": "freeflow-proxy",
  "type": "module",
  "version": "1.0.0",
  "description": "Local OpenAI-compatible proxy exposing free OpenCode Zen, KiloCode and Cline models to any coding agent",
  "main": "server.ts",
  "keywords": [
    "openai",
    "openai-compatible",
    "proxy",
    "llm",
    "free-models",
    "opencode",
    "kilocode",
    "cline",
    "coding-agent",
    "local"
  ],
  "author": "trefeon",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node --experimental-strip-types server.ts",
    "test": "node --experimental-strip-types --import ./test/setup.mjs --test --test-concurrency=1 test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "undici": "7.30.0"
  }
}